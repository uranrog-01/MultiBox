<UserControl x:Class="MultiBox.Setup.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Left">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource BrushLimeGradient}"
                    VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="#BAFF2A" BlurRadius="28" ShadowDepth="0" Opacity="0.4" />
                </Border.Effect>
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                           Foreground="#0A1207" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
            </Border>
            <StackPanel Grid.Column="1" Margin="22,4,0,0">
                <TextBlock Style="{StaticResource Display}" FontSize="30" x:Name="HeadlineText" Text="MultiBox is ready." />
                <TextBlock Style="{StaticResource Subheading}" Margin="0,8,0,0" TextWrapping="Wrap"
                           x:Name="SubText" Text="Everything is installed and registered." />
            </StackPanel>
        </Grid>

        <!-- Where it went -->
        <Border Style="{StaticResource Card}" Margin="0,28,0,0" Padding="18,15">
            <StackPanel>
                <TextBlock Style="{StaticResource Dim}" FontWeight="SemiBold" FontSize="11" Text="INSTALLED TO" />
                <TextBlock x:Name="InstallPathText" Style="{StaticResource Body}" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                           FontSize="12.5" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Text="" />
                <TextBlock x:Name="ExtrasText" Style="{StaticResource Micro}" Margin="0,8,0,0"
                           Text="Shortcuts and the Add/Remove Programs entry were created." />
            </StackPanel>
        </Border>

        <!-- Launch option -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Launch MultiBox now" />
                    <TextBlock Style="{StaticResource Micro}" Margin="0,4,0,0"
                               Text="Create your first isolated session right away — or later from the Start menu." />
                </StackPanel>
                <CheckBox x:Name="LaunchCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Micro}" Margin="4,18,0,0" TextWrapping="Wrap"
                   Text="Your session data lives in %LocalAppData%\MultiBox and is kept if you ever uninstall — the uninstaller asks before removing it." />
    </StackPanel>
</UserControl>
