<UserControl x:Class="MultiBox.Setup.DestinationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel VerticalAlignment="Top" MaxWidth="660" HorizontalAlignment="Left" Margin="0,2,0,2">

        <TextBlock Style="{StaticResource Heading}" FontSize="23" Text="Where should MultiBox live?" />
        <TextBlock Style="{StaticResource Subheading}" Margin="0,7,0,18" TextWrapping="Wrap"
                   Text="A single self-contained folder. You can move or delete it whenever you like." />

        <!-- Install location card -->
        <Border Style="{StaticResource Card}" Padding="18,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Dim}" FontWeight="SemiBold" FontSize="11" Text="INSTALL LOCATION"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,6" FontSize="12"
                            Content="Browse…" Click="Browse_Click" />
                </Grid>

                <TextBox x:Name="PathBox" Style="{StaticResource Field}" Margin="0,11,0,0"
                         TextChanged="PathBox_TextChanged" />

                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DiskText" Style="{StaticResource Dim}" VerticalAlignment="Center" Text="Checking disk space…" />
                    <Button x:Name="DefaultReset" Grid.Column="1" Style="{StaticResource LinkButton}" FontSize="11"
                            Content="Reset to default" Click="ResetDefault_Click" Visibility="Collapsed" />
                </Grid>
                <Border x:Name="DiskBarTrack" Height="4" CornerRadius="2" Background="#16FFFFFF" Margin="0,8,0,0">
                    <Border x:Name="DiskBar" HorizontalAlignment="Left" Width="0" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#BAFF2A" Offset="0" />
                                <GradientStop Color="#72E6DB" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDanger}" FontSize="12" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Options card -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Dim}" FontWeight="SemiBold" FontSize="11" Text="OPTIONS" Margin="0,0,0,10" />
                <CheckBox x:Name="DesktopShortcutCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                          Content="Desktop shortcut" Margin="0,0,0,9" />
                <CheckBox x:Name="StartMenuCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                          Content="Start menu folder with uninstaller" Margin="0,0,0,9" />
                <CheckBox x:Name="LaunchCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                          Content="Launch MultiBox when setup closes" Margin="0,0,0,2" />
            </StackPanel>
        </Border>

        <!-- All-users card -->
        <Border x:Name="AllUsersCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14"
                BorderBrush="#2EBAFF2A" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10BAFF2A" Offset="0" />
                    <GradientStop Color="#0D120F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <CheckBox x:Name="AllUsersCheck" Style="{StaticResource ToggleSwitch}" Content="Install for all users on this PC"
                          Checked="AllUsers_Changed" Unchecked="AllUsers_Changed" />
                <TextBlock Style="{StaticResource Micro}" Margin="52,7,0,0" TextWrapping="Wrap"
                           Text="Installs to Program Files and registers for every account. Windows will ask for administrator permission — MultiBox itself never needs admin to run." />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
