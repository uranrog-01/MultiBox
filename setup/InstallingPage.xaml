<UserControl x:Class="MultiBox.Setup.InstallingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="PulseDot" Width="9" Height="9" CornerRadius="4.5" Background="{StaticResource BrushLime}"
                    VerticalAlignment="Center" Margin="0,1,12,0" />
            <TextBlock x:Name="StageText" Style="{StaticResource Heading}" FontSize="21" Text="Preparing..." />
        </StackPanel>

        <TextBlock x:Name="FileText" Grid.Row="1" Style="{StaticResource Dim}" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                   FontSize="11" Margin="21,8,0,0" TextTrimming="CharacterEllipsis" Text="" />

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <ProgressBar x:Name="Progress" Style="{StaticResource InstallProgress}" Height="8" Minimum="0" Maximum="1" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="PercentText" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushLime}" Text="0%" />
            <TextBlock x:Name="RemainHint" Style="{StaticResource Micro}" Margin="12,1,0,0"
                       Text="Hang tight - this is quick." />
        </StackPanel>

        <!-- Log tail -->
        <Border x:Name="LogCard" Grid.Row="4" Margin="0,20,0,0" CornerRadius="11" Background="#0C100E"
                BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14,10" MaxHeight="150">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="10.5"
                           Foreground="#7E8C82" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- Error state -->
        <Border x:Name="ErrorCard" Grid.Row="4" Margin="0,20,0,0" Style="{StaticResource Card}"
                BorderBrush="#66FF7A70" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#14FF7A70" Offset="0" />
                    <GradientStop Color="#0D120F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="11,0,0,0"
                               Text="Installation didn't finish" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Dim}" Margin="26,8,0,0" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Micro}" Margin="26,10,0,0" TextWrapping="Wrap"
                           Text="Nothing was left half-installed - setup cleaned up. Press Back to adjust the destination and try again. Details: %LocalAppData%\MultiBox\Setup\Logs" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
