<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette (mirrors UI/design.css "luminous glass") ============ -->
    <Color x:Key="ColBg">#050807</Color>
    <Color x:Key="ColSurface">#121714</Color>
    <Color x:Key="ColSurfaceDeep">#0C100E</Color>
    <Color x:Key="ColLime">#BAFF2A</Color>
    <Color x:Key="ColLimeDeep">#9BE82B</Color>
    <Color x:Key="ColLimeSoft">#D6FF6B</Color>
    <Color x:Key="ColCyan">#72E6DB</Color>
    <Color x:Key="ColDanger">#FF7A70</Color>
    <Color x:Key="ColText">#EEF3EA</Color>
    <Color x:Key="ColTextDim">#93A08F</Color>
    <Color x:Key="ColTextFaint">#5E6B62</Color>

    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceDeep" Color="{StaticResource ColSurfaceDeep}" />
    <SolidColorBrush x:Key="BrushLime" Color="{StaticResource ColLime}" />
    <SolidColorBrush x:Key="BrushLimeDeep" Color="{StaticResource ColLimeDeep}" />
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColCyan}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColDanger}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColTextDim}" />
    <SolidColorBrush x:Key="BrushTextFaint" Color="{StaticResource ColTextFaint}" />
    <SolidColorBrush x:Key="BrushCardBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BrushCardBorderHi" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BrushHairline" Color="#14FFFFFF" />

    <LinearGradientBrush x:Key="BrushLimeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9FF62" Offset="0" />
        <GradientStop Color="#BAFF2A" Offset="0.55" />
        <GradientStop Color="#9BE82B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardWash" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#182119" Offset="0" />
        <GradientStop Color="#0D120F" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="BrushLimeGlow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#22BAFF2A" Offset="0" />
        <GradientStop Color="#00BAFF2A" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="EffectLimeGlow" Color="#BAFF2A" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
    <DropShadowEffect x:Key="EffectDangerGlow" Color="#FF7A70" BlurRadius="22" ShadowDepth="0" Opacity="0.35" />

    <!-- ============ Typography ============ -->
    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>
    <Style x:Key="Subheading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextDim}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextDim}" />
    </Style>
    <Style x:Key="Micro" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrushLime}" />
    </Style>

    <!-- ============ Chip ============ -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#14BAFF2A" />
        <Setter Property="BorderBrush" Value="#2EBAFF2A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="9,3.5" />
    </Style>

    <!-- ============ Cards ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCardWash}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,13" />
    </Style>

    <!-- ============ Buttons ============ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0A1207" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource BrushLimeGradient}" CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource EffectLimeGlow}" />
                            <Setter TargetName="Root" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E7FF8F" Offset="0" />
                                        <GradientStop Color="#C8FF4D" Offset="0.55" />
                                        <GradientStop Color="#A8F133" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#93A08F" />
                            <Setter TargetName="Root" Property="Background" Value="#28312A" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#D7E2D3" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" BorderBrush="#26FFFFFF" BorderThickness="1"
                            CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#0FFFFFFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#3DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{StaticResource BrushCyan}"
                                   FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold">
                            <TextBlock.TextDecorations>
                                <TextDecoration Location="Underline" PenOffset="2" PenOffsetUnit="Pixel">
                                    <TextDecoration.Pen>
                                        <Pen Brush="#5572E6DB" Thickness="1" />
                                    </TextDecoration.Pen>
                                </TextDecoration>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Foreground" Value="#A8F2EA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleGlyphButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="#9AA59E" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#0FFFFFFF" />
                            <Setter Property="Foreground" Value="#F1F5EE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Toggle switch (modern checkbox) ============ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Track" DockPanel.Dock="Left" Width="42" Height="23" CornerRadius="11.5"
                                Background="#0C100E" BorderBrush="#2EFFFFFF" BorderThickness="1" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="15" Height="15" Fill="#93A08F"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushLimeGradient}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#66BAFF2A" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#0A1207" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="19" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#4DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard checkbox with lime check -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Box" DockPanel.Dock="Left" Width="19" Height="19" CornerRadius="6"
                                Background="#0C100E" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" Foreground="#0A1207" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushLime}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#66BAFF2A" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#55FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Textbox ============ -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushLime}" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="#0C100E" BorderBrush="#26FFFFFF" BorderThickness="1"
                            CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushLime}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#3DFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Progress bar ============ -->
    <Style x:Key="InstallProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="7" />
        <Setter Property="Foreground" Value="{StaticResource BrushLimeGradient}" />
        <Setter Property="Background" Value="#16FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3.5" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="3.5" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrollbar ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#2EFFFFFF" CornerRadius="4" Margin="1" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Step indicator ============ -->
    <Style x:Key="StepDot" TargetType="Border">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="3.5" />
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style x:Key="StepLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
    </Style>

</ResourceDictionary>
