<Window x:Class="MultiBox.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiBox Setup" Width="960" Height="700"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="RootFrame" CornerRadius="18" Background="#060807"
            BorderBrush="#2BFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="46" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <!-- Ambient layers, mirrors the app's luminous-glass background -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Canvas.Left="-260" Canvas.Top="-220" Width="640" Height="560" Opacity="0.75">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#26BAFF2A" Offset="0" />
                            <GradientStop Color="#00BAFF2A" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Right="-260" Canvas.Bottom="-260" Width="620" Height="540" Opacity="0.7">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1F55CBB5" Offset="0" />
                            <GradientStop Color="#0055CBB5" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ======== Titlebar ======== -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="9" Background="#14BAFF2A"
                                BorderBrush="#2EBAFF2A" BorderThickness="1">
                            <Image Source="Assets/icon.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="MULTIBOX SETUP" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F0F6EE" VerticalAlignment="Center" Margin="12,1,0,0" />
                        <Border Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionChipText" Style="{StaticResource Micro}" Foreground="#D3F58E"
                                       FontSize="9.5" FontWeight="SemiBold" Text="INSTALLER" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                        <Button Style="{StaticResource TitleGlyphButton}" Content="&#xE921;" ToolTip="Minimize"
                                Click="Minimize_Click" />
                        <Button Style="{StaticResource TitleGlyphButton}" Content="&#xE711;" ToolTip="Close"
                                Click="Close_Click" />
                    </StackPanel>
                    <Border Height="1" VerticalAlignment="Bottom" Background="#14FFFFFF" />
                </Grid>

                <!-- ======== Page host ======== -->
                <Grid Grid.Row="1" Margin="30,14,30,6" x:Name="ContentHost" />

                <!-- ======== Footer ======== -->
                <Grid Grid.Row="2" Margin="30,8,30,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Step indicator -->
                    <StackPanel x:Name="StepHost" Orientation="Horizontal" VerticalAlignment="Center" />

                    <!-- Navigation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="Back"
                                Width="96" Margin="0,0,10,0" Click="Back_Click" />
                        <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="Continue"
                                Width="150" Click="Next_Click" />
                        <Button x:Name="CancelButton" Style="{StaticResource LinkButton}" Content="Cancel setup"
                                Margin="14,0,0,0" Visibility="Collapsed" Click="CancelInstall_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
